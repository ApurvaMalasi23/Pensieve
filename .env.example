# NVIDIA NIM API key (required for metadata extraction)
NVIDIA_API_KEY=nvapi-...

# Optional: override the NVIDIA NIM base URL (default: https://integrate.api.nvidia.com/v1)
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional: override the default model used for metadata extraction
# PENSIEVE_LLM_MODEL=meta/llama-3.1-70b-instruct

# Optional: override the default output and manifest directories
# PENSIEVE_OUTPUT_DIR=./output
# PENSIEVE_MANIFEST_PATH=./manifest.csv
