# =============================================================================
# Pensieve — Environment Variable Reference
# Copy this file to .env and fill in your values.
# .env is gitignored and must NEVER be committed.
# =============================================================================

# -----------------------------------------------------------------------------
# NVIDIA NIM (required — used for metadata extraction, classification, generation)
# Get your key at: https://build.nvidia.com/
# -----------------------------------------------------------------------------
NVIDIA_API_KEY=nvapi-...

# Optional: override the NIM base URL (default shown)
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional: override the model used for metadata extraction / classification
# PENSIEVE_LLM_MODEL=meta/llama-3.1-70b-instruct

# Optional: override the model used for RAG answer generation
# PENSIEVE_GENERATION_MODEL=meta/llama-3.2-11b-vision-instruct

# -----------------------------------------------------------------------------
# Qdrant Cloud vector store (required for cloud deployment)
# Get a free cluster at: https://cloud.qdrant.io/
# For local development with Docker, leave these unset (defaults to localhost:6333)
# -----------------------------------------------------------------------------
QDRANT_URL=https://<your-cluster-id>.<region>.aws.cloud.qdrant.io
QDRANT_API_KEY=<your-qdrant-api-key>

# Optional: override the collection name (default shown)
# QDRANT_COLLECTION=pensieve_chunks

# -----------------------------------------------------------------------------
# Embedding provider (optional — defaults to local)
# "local"  → BAAI/bge-small-en-v1.5 via sentence-transformers (no API key needed)
# "openai" → text-embedding-3-small via OpenAI API (requires OPENAI_API_KEY)
# -----------------------------------------------------------------------------
# PENSIEVE_EMBEDDING_PROVIDER=local
# OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# Public demo / showcase mode (optional)
# When SHOWCASE_MODE=true, document upload and deletion are disabled (read-only).
# -----------------------------------------------------------------------------
# SHOWCASE_MODE=false

# -----------------------------------------------------------------------------
# Runtime output paths (optional — defaults shown)
# -----------------------------------------------------------------------------
# PENSIEVE_OUTPUT_DIR=./output
# PENSIEVE_MANIFEST_PATH=./manifest.csv
